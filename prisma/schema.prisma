// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth) ───────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User & Organization ───────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String?   // hashed, null for OAuth users
  locale        String    @default("en-US")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   OrgMember[]
  jobs          Job[]         @relation("JobCreatedBy")
  assignedJobs  Job[]         @relation("JobAssignedTo")
  auditLogs     AuditLog[]
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrgMember[]
  templates   Template[]
  jobs        Job[]
  subscription Subscription?
  apiKeys     ApiKey[]
  emailInboxes EmailInbox[]
  aiConfig    AiConfig?
  invites     OrgInvite[]
  emailAccounts EmailAccount[]
  auditLogs   AuditLog[]
  webhookEndpoints WebhookEndpoint[]
}

model OrgMember {
  id     String @id @default(cuid())
  role   OrgRole @default(MEMBER)
  userId String
  orgId  String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// ─── Subscription (Stripe) ────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  orgId                String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 PlanType           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  seats                Int                @default(1)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

// ─── Template ─────────────────────────────────────────────────────────────

model Template {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  prompt      String   @db.Text
  outputSchema Json    // JSON Schema defining expected output structure
  webhookUrl  String?  // legacy: direct URL (kept for backward compat)
  webhookHeaders Json? // legacy
  webhookFormat String @default("raw")
  webhookEndpointId String? // reference to shared WebhookEndpoint
  slaDays     Int?
  fieldRules  Json?
  notifyOnNew Boolean  @default(false)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jobs Job[]
  emailInboxes EmailInbox[]
  emailAccounts EmailAccount[]
  webhookEndpoint WebhookEndpoint? @relation(fields: [webhookEndpointId], references: [id], onDelete: SetNull)
}

// ─── Job (Parse Task) ─────────────────────────────────────────────────────

model Job {
  id           String    @id @default(cuid())
  orgId        String
  templateId   String
  createdById  String
  status       JobStatus @default(PENDING)

  // Input
  fileName     String
  fileUrl      String
  fileType     String    // mime type
  fileSize     Int
  extractedText String?  @db.Text  // raw text extracted from file

  // AI Output
  rawResult    Json?     // raw AI response
  parsedData   Json?     // structured JSON after parsing
  confidence   Float?    // AI confidence score 0-1

  // Review
  reviewedData Json?     // human-edited version
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  // Assignment
  assignedToId String?   // assigned reviewer
  assignedAt   DateTime?

  // SLA
  slaDeadline  DateTime? // computed from template.slaDays at creation
  slaBreached  Boolean   @default(false)

  // Webhook
  webhookStatus WebhookStatus @default(PENDING)
  webhookResponse Json?
  webhookSentAt DateTime?

  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template   Template     @relation(fields: [templateId], references: [id])
  createdBy  User         @relation("JobCreatedBy", fields: [createdById], references: [id])
  assignedTo User?        @relation("JobAssignedTo", fields: [assignedToId], references: [id])
}

enum JobStatus {
  PENDING
  PROCESSING
  PARSED
  REVIEWING
  APPROVED
  REJECTED
  SENT
  FAILED
}

enum WebhookStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}

// ─── API Keys ─────────────────────────────────────────────────────────────

model ApiKey {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  keyHash     String   @unique  // bcrypt hash of the actual key
  keyPrefix   String            // first 8 chars for display (e.g. "db_live_")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

// ─── Email Inbox ──────────────────────────────────────────────────────────

model EmailInbox {
  id          String   @id @default(cuid())
  orgId       String
  templateId  String
  address     String   @unique  // e.g. "acme-invoices@inbound.databridge.dev"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template Template     @relation(fields: [templateId], references: [id])
}

// ─── Webhook Endpoint ─────────────────────────────────────────────────────

model WebhookEndpoint {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  url         String
  headers     Json?    // custom headers
  format      String   @default("raw") // "raw" | "zapier"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templates Template[]
}

// ─── Audit Log ────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  action    String   // e.g. "job.approve", "job.assign", "template.create"
  entityType String  // "job" | "template" | "member" | "apikey"
  entityId  String
  meta      Json?    // extra context (old/new values, etc.)
  ip        String?
  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ─── Email Account (IMAP) ─────────────────────────────────────────────────

model EmailAccount {
  id          String   @id @default(cuid())
  orgId       String
  name        String                        // display name
  email       String
  imapHost    String
  imapPort    Int      @default(993)
  imapSecure  Boolean  @default(true)
  username    String
  password    String   @db.Text             // stored as-is; encrypt in prod
  templateId  String?                       // default template for this inbox
  active      Boolean  @default(true)
  lastSyncAt  DateTime?
  lastUid     Int      @default(0)          // last fetched UID for incremental sync
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template Template?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
}


model OrgInvite {
  id        String    @id @default(cuid())
  orgId     String
  email     String
  role      OrgRole   @default(MEMBER)
  token     String    @unique @default(cuid())
  invitedBy String
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime  @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, email])
}


model AiConfig {
  id           String   @id @default(cuid())
  orgId        String   @unique
  provider     String   @default("anthropic") // "anthropic" | "openai" | "custom"
  apiKey       String   @db.Text              // encrypted or plain — org-level override
  baseUrl      String?                        // custom base URL (optional)
  model        String?                        // model override, e.g. "claude-opus-4-5"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

