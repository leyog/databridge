// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth (NextAuth) ───────────────────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── User & Organization ───────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  locale        String    @default("en-US")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  memberships   OrgMember[]
  jobs          Job[]
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrgMember[]
  templates   Template[]
  jobs        Job[]
  subscription Subscription?
}

model OrgMember {
  id     String @id @default(cuid())
  role   OrgRole @default(MEMBER)
  userId String
  orgId  String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

// ─── Subscription (Stripe) ────────────────────────────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  orgId                String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 PlanType           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  seats                Int                @default(1)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

// ─── Template ─────────────────────────────────────────────────────────────

model Template {
  id          String   @id @default(cuid())
  orgId       String
  name        String
  description String?
  prompt      String   @db.Text
  outputSchema Json    // JSON Schema defining expected output structure
  webhookUrl  String?  // API endpoint to write back to
  webhookHeaders Json? // Custom headers for webhook
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  jobs Job[]
}

// ─── Job (Parse Task) ─────────────────────────────────────────────────────

model Job {
  id           String    @id @default(cuid())
  orgId        String
  templateId   String
  createdById  String
  status       JobStatus @default(PENDING)

  // Input
  fileName     String
  fileUrl      String
  fileType     String    // mime type
  fileSize     Int

  // AI Output
  rawResult    Json?     // raw AI response
  parsedData   Json?     // structured JSON after parsing
  confidence   Float?    // AI confidence score 0-1

  // Review
  reviewedData Json?     // human-edited version
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  // Webhook
  webhookStatus WebhookStatus @default(PENDING)
  webhookResponse Json?
  webhookSentAt DateTime?

  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  template   Template     @relation(fields: [templateId], references: [id])
  createdBy  User         @relation(fields: [createdById], references: [id])
}

enum JobStatus {
  PENDING
  PROCESSING
  PARSED
  REVIEWING
  APPROVED
  REJECTED
  SENT
  FAILED
}

enum WebhookStatus {
  PENDING
  SUCCESS
  FAILED
  SKIPPED
}
